APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Optional. Without it the API and bot still work: NOTAMs fall back to the
# offline dictionary decoder (decoded_by="dictionary" instead of "ai").
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash-lite

ANAC_NOTAM_BASE_URL=https://ais.anac.gob.ar
ANAC_NOTAM_INDICATORS_TTL=3600
ANAC_NOTAM_TTL=300

# METAR. www.smn.gob.ar/metar es un iframe sobre esta aplicación legacy del SMN.
# Hay un Cloudflare adelante que bloquea por tramos. La caché baja el volumen de
# pedidos y el cooldown deja de golpear la fuente que falló, que es lo que
# permite que el bloqueo expire; mientras tanto contesta NOAA.
METAR_TTL=600
METAR_SOURCE_COOLDOWN=900

# Fuente primaria. Subir SMN_METAR_ATTEMPTS empeora el bloqueo en vez de
# aliviarlo: los reintentos sólo cubren el desafío aislado.
SMN_METAR_BASE_URL=https://ssl.smn.gob.ar
SMN_METAR_ATTEMPTS=2

# Respaldo: los mismos METAR emitidos por el SMN, relayados por el intercambio
# OPMET/OMM. Sin API key.
NOAA_METAR_BASE_URL=https://aviationweather.gov
NOAA_METAR_HOURS=2

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
