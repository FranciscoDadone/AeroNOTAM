APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Sólo el panel /admin lee en esta zona; el bot contesta siempre en UTC.
# APP_DISPLAY_TIMEZONE=America/Argentina/Buenos_Aires

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Optional. Without it the API and bot still work: NOTAMs fall back to the
# offline dictionary decoder (decoded_by="dictionary" instead of "ai").
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash-lite

ANAC_NOTAM_BASE_URL=https://ais.anac.gob.ar
ANAC_NOTAM_INDICATORS_TTL=3600
ANAC_NOTAM_TTL=300

# MADHEL, el registro oficial de aeródromos de ANAC. Lo lee sólo
# notams:import-madhel, semanalmente. MADHEL_MINIMUM_COUNT es el piso por
# debajo del cual la respuesta se toma por truncada y el import se aborta,
# para que un error del servicio no achique el registro.
MADHEL_BASE_URL=https://datos.anac.gob.ar
MADHEL_MINIMUM_COUNT=500

# METAR y TAF. www.smn.gob.ar/metar y /taf son iframes sobre la misma
# aplicación legacy del SMN. Hay un Cloudflare adelante que bloquea por tramos.
# La caché baja el volumen de pedidos y el cooldown deja de golpear la fuente
# que falló, que es lo que permite que el bloqueo expire; mientras tanto
# contesta NOAA.
#
# El cooldown es uno solo para los dos: el bloqueo es contra nosotros en la
# puerta del SMN, no contra una de sus páginas.
WEATHER_SOURCE_COOLDOWN=900

# Los METAR se emiten cada hora; los TAF, cada seis. De ahí la diferencia de
# caché. El TAF no va más alto por las enmiendas (AMD), que salen justo cuando
# el pronóstico cambió lo suficiente como para importar.
METAR_TTL=600
TAF_TTL=1800

# Suscripciones "avisame si cambia el METAR". El máximo no es arbitrario:
# WhatsApp sólo deja escribirle libremente a alguien dentro de las 24 horas de
# su último mensaje, y todo aviso tiene que caer dentro de esa ventana.
METAR_WATCH_TTL=43200
METAR_WATCH_MAX_TTL=86400
METAR_WATCH_MAX=5

# Fuente primaria. Subir SMN_METAR_ATTEMPTS empeora el bloqueo en vez de
# aliviarlo: los reintentos sólo cubren el desafío aislado.
SMN_METAR_BASE_URL=https://ssl.smn.gob.ar
SMN_METAR_ATTEMPTS=2

# Respaldo: los mismos METAR y TAF emitidos por el SMN, relayados por el
# intercambio OPMET/OMM. Sin API key. La ventana del TAF tiene que cubrir un
# ciclo de emisión entero, o una estación que todavía no reemitió se lee como
# si no tuviera pronóstico.
NOAA_METAR_BASE_URL=https://aviationweather.gov
NOAA_METAR_HOURS=2
NOAA_TAF_HOURS=8

# Servicio de Hidrografía Naval: crepúsculos y salida/puesta del sol. Una
# consulta trae el mes entero y esa tabla ya está publicada de antemano, así que
# la caché es de treinta días: no hay nada que revalidar.
SHN_BASE_URL=https://www.hidro.gov.ar
SHN_SUN_TTL=2592000

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Plantillas de los dos mensajes con botón (alta desde el METAR, baja desde el
# aviso). Se crean una sola vez con `php artisan whatsapp:content-templates` y
# se pegan acá. En blanco, los dos mensajes salen igual en texto plano con el
# comando escrito equivalente.
TWILIO_CONTENT_SID_METAR=
TWILIO_CONTENT_SID_ALERT=
